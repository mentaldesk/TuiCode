<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TuiCode.Workbench\TuiCode.Workbench.csproj" />
    <ProjectReference Include="..\TuiCode.Explorer\TuiCode.Explorer.csproj" />
    <ProjectReference Include="..\TuiCode.Icons\TuiCode.Icons.csproj" />
    <ProjectReference Include="..\TuiCode.Search\TuiCode.Search.csproj" />
    <ProjectReference Include="..\TuiCode.Editor\TuiCode.Editor.csproj" />
    <ProjectReference Include="..\TuiCode.Syntax\TuiCode.Syntax.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.7" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- Release archives ship these notices beside the binary; see "Release workflow" in AGENTS.md. -->
  <Target Name="PublishThirdPartyNotices" AfterTargets="Publish" Condition="'$(PublishAot)' == 'true'">
    <PropertyGroup>
      <_DotnetNotices>$(RuntimePackagePath)/THIRD-PARTY-NOTICES.TXT</_DotnetNotices>
    </PropertyGroup>
    <Error Condition="!Exists('$(_DotnetNotices)')" Text="The .NET runtime's third-party notices weren't found at $(_DotnetNotices)." />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.md" DestinationFolder="$(PublishDir)" />
    <Copy SourceFiles="$(_DotnetNotices)" DestinationFiles="$(PublishDir)DOTNET-THIRD-PARTY-NOTICES.TXT" />
  </Target>

</Project>
