{
    "version": "{{version}}",
    "description": "Minimalist terminal code editor for working over SSH",
    "homepage": "https://github.com/mentaldesk/TuiCode",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/mentaldesk/TuiCode/releases/download/v{{version}}/tuicode-{{version}}-win-x64.zip",
            "hash": "{{sha_win_x64}}"
        },
        "arm64": {
            "url": "https://github.com/mentaldesk/TuiCode/releases/download/v{{version}}/tuicode-{{version}}-win-arm64.zip",
            "hash": "{{sha_win_arm64}}"
        }
    },
    "bin": [
        [
            "TuiCode.exe",
            "tuicode"
        ]
    ],
    "shortcuts": [
        [
            "TuiCode.exe",
            "TuiCode"
        ]
    ],
    "checkver": {
        "github": "https://github.com/mentaldesk/TuiCode"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/mentaldesk/TuiCode/releases/download/v$version/tuicode-$version-win-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/mentaldesk/TuiCode/releases/download/v$version/tuicode-$version-win-arm64.zip"
            }
        },
        "hash": {
            "url": "$url.sha256"
        }
    }
}
